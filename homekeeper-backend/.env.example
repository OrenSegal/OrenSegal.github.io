# HomeKeeper Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM PROVIDER - Choose ONE
# =============================================================================

# Option 1: GROQ (FREE - Recommended for cloud deployment)
# Get free API key at: https://console.groq.com/
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# Option 2: OLLAMA (FREE - For local development)
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull model: ollama pull llama3.1
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# Option 3: ANTHROPIC (Paid - Best quality)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key

# =============================================================================
# DATABASE
# =============================================================================

# SQLite (Free, local - good for development)
DATABASE_URL=sqlite:///./homekeeper.db

# PostgreSQL (For production)
# DATABASE_URL=postgresql://user:password@localhost:5432/homekeeper

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# AWS S3 (for warranty documents)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_BUCKET=homekeeper-warranties

# Twilio (for SMS alerts)
# TWILIO_ACCOUNT_SID=your-sid
# TWILIO_AUTH_TOKEN=your-token
